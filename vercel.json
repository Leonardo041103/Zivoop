{
  "cleanUrls": false,
  "functions": {
    "api/site.js": {
      "includeFiles": "public/modelos/*/{index.html,padrao.json}",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/painel",
      "destination": "/painel/index.html"
    },
    {
      "source": "/ofertas",
      "destination": "/ofertas/index.html"
    },
    {
      "source": "/:slug([a-z0-9][a-z0-9-]{2,39})",
      "destination": "/api/site?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/painel/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/ofertas/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/zv-site.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|jpg|png|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)sw\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}