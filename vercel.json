{
  "cleanUrls": false,
  "functions": {
    "api/site.js": {
      "includeFiles": "public/modelos/*/{index.html,padrao.json}",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/painel",
      "destination": "/painel/index.html"
    },
    {
      "source": "/lanchonete/painel",
      "destination": "/lanchonete/painel/index.html"
    },
    {
      "source": "/barbearia/painel",
      "destination": "/barbearia/painel/index.html"
    },
    {
      "source": "/ofertas",
      "destination": "/ofertas/index.html"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade/index.html"
    },
    {
      "source": "/termos",
      "destination": "/termos/index.html"
    },
    {
      "source": "/:slug([a-z0-9][a-z0-9-]{2,39})",
      "destination": "/api/site?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/painel/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/ofertas/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/zv-site.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|jpg|png|svg|ico|glb|onnx)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)sw\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=(), payment=(), usb=()"
        }
      ]
    }
  ]
}